[Unit]
Description=FastResearch Go service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/fastresearch
EnvironmentFile=/srv/fastresearch/.env.production
ExecStart=/srv/fastresearch/bin/fastresearch
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
