{
  "name": "fastresearch-console",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @fastrd/fastresearch-web",
    "server": "go run ./cmd/fastresearch",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm run build --workspace @fastrd/fastresearch-web",
    "build:server": "go build -trimpath -o bin/fastresearch ./cmd/fastresearch",
    "lint": "npm run lint --workspace @fastrd/fastresearch-web && go vet ./cmd/... ./internal/...",
    "preview": "npm run preview --workspace @fastrd/fastresearch-web",
    "test": "go test ./cmd/... ./internal/...",
    "test:integration": "go test ./internal/httpapi ./internal/identity ./internal/workflow",
    "test:visual": "node scripts/fastui-browser.mjs",
    "test:fastui": "node scripts/fastui-browser.mjs",
    "test:promo": "node scripts/promo-visual-check.mjs",
    "test:journey": "node scripts/journey-browser.mjs",
    "start": "./bin/fastresearch",
    "test:workspace": "node scripts/workspace-visual-check.mjs",
    "test:activity": "node scripts/activity-browser.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  },
  "workspaces": [
    "web"
  ]
}
