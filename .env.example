VITE_API_URL=
PORT=8787
FASTRESEARCH_PUBLIC_URL=http://127.0.0.1:8787
FASTRESEARCH_JWT_SECRET=
FASTRESEARCH_COOKIE_DOMAIN=
FASTRESEARCH_CORS_ORIGINS=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
FASTINSIGHT_INGEST_KEY=fastinsight-test-key-2026
# FastInsight colleagues.yaml path. Relative paths resolve from FastResearch.
FASTINSIGHT_ROSTER=../fastinsight/assets/colleagues.yaml
FASTTASK_INGEST_KEY=replace-with-a-long-random-fasttask-key
# Optional FastCAS client. Configure all four values to enable the login button.
FASTRESEARCH_FASTCAS_ISSUER=
FASTRESEARCH_FASTCAS_CLIENT_ID=
FASTRESEARCH_FASTCAS_CLIENT_SECRET=
FASTRESEARCH_FASTCAS_REDIRECT_URI=
FASTRESEARCH_FASTCAS_AUDIENCE=research-api
# JSON map from service client_id to permitted local account IDs.
FASTRESEARCH_FASTCAS_ALLOWED_TARGETS={}
FASTRESEARCH_FASTCAS_ALLOW_LOOPBACK_HTTP=false
VITE_READ_URL=http://127.0.0.1:3015
FASTREAD_URL=http://127.0.0.1:3015
FASTREAD_PROXY_URL=http://127.0.0.1:3015
VITE_WRITE_URL=http://127.0.0.1:3003
FASTWRITE_URL=http://127.0.0.1:3003
FASTWRITE_PUBLIC_URL=http://127.0.0.1:3003
FASTWRITE_API_KEY=
FASTTASK_URL=http://127.0.0.1:10000
FASTTASK_API_KEY=replace-with-fasttask-ingress-key
# Optional; set only when FastTask provides account lifecycle endpoints.
FASTTASK_PROVISION_KEY=
# Public FastTask origin used to validate external SSO callbacks.
FASTTASK_PUBLIC_URL=http://127.0.0.1:10000
# Must match FASTTASK_FASTRESEARCH_SSO_SECRET in FastTask and contain at least 32 characters.
FASTRESEARCH_FASTTASK_SSO_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional per-account callback keys. Each entry uses the FastResearch accountId
# and the same pair key configured in FastTask FASTTASK_FASTRESEARCH_BINDINGS.
FASTTASK_API_KEYS=[]
VITE_FASTTASK_URL=
VITE_FASTNEWS_URL=http://127.0.0.1:4173
VITE_FASTPPT_URL=
VITE_FASTLAB_URL=
HOST=127.0.0.1
