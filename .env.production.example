HOST=0.0.0.0
PORT=8787
FASTRESEARCH_PUBLIC_URL=https://fastrd.io
FASTRESEARCH_DATA_DIR=data
FASTRESEARCH_STATIC_DIR=dist
FASTRESEARCH_COOKIE_NAME=__Host-fr_session
FASTRESEARCH_COOKIE_DOMAIN=
FASTRESEARCH_CORS_ORIGINS=https://fastrd.io

# All four fields are required together. Register this callback in FastCAS.
# Standard login needs openid profile email. Opt into offline access only after
# the central client permits offline_access and the refresh_token grant.
FASTRESEARCH_FASTCAS_ISSUER=https://cas.fastrd.io
FASTRESEARCH_FASTCAS_CLIENT_ID=research
FASTRESEARCH_FASTCAS_CLIENT_SECRET=
FASTRESEARCH_FASTCAS_REDIRECT_URI=https://fastrd.io/api/auth/fastcas/callback
FASTRESEARCH_FASTCAS_OFFLINE_ACCESS=false
FASTRESEARCH_FASTCAS_ALLOW_LOOPBACK_HTTP=false
# No self-registration or local administrator password is supported.
# Member Key login remains available. Never grants administrator access.
FASTRESEARCH_ALLOW_LEGACY_KEY_LOGIN=true

FASTINSIGHT_ROSTER=../FastInsight/assets/colleagues.yaml
FASTRESEARCH_FASTCAS_INGEST_CLIENT_ID=fastinsight
FASTRESEARCH_FASTCAS_INGEST_ALLOWED_ACCOUNT_IDS=
# JSON map: service client IDs -> stable Research account IDs.
FASTRESEARCH_FASTCAS_ALLOWED_TARGETS={}
FASTRESEARCH_ALLOW_LEGACY_FASTINSIGHT_KEY=false
FASTINSIGHT_INGEST_KEY=
FASTRESEARCH_ALLOW_LEGACY_FASTTASK_KEYS=false
FASTTASK_INGEST_KEY=
FASTRESEARCH_ALLOW_LEGACY_FASTWRITE_KEY=false
FASTWRITE_API_KEY=
FASTTASK_API_KEY=

VITE_API_URL=
VITE_READ_URL=http://127.0.0.1:3015
VITE_WRITE_URL=http://127.0.0.1:3003
VITE_FASTTASK_URL=http://127.0.0.1:10000
VITE_FASTNEWS_URL=http://127.0.0.1:4173
VITE_FASTPPT_URL=
VITE_FASTLAB_URL=
FASTREAD_URL=http://127.0.0.1:3015
FASTWRITE_URL=http://127.0.0.1:3003
FASTTASK_URL=http://127.0.0.1:10000
FASTNEWS_URL=http://127.0.0.1:4173
FASTNEWS_PUBLIC_URL=
FASTREAD_PUBLIC_URL=
FASTWRITE_PUBLIC_URL=
FASTTASK_PUBLIC_URL=
FASTPPT_PUBLIC_URL=
FASTLAB_PUBLIC_URL=
FASTNEWS_CAS_LOGIN_URL=
FASTREAD_CAS_LOGIN_URL=
FASTWRITE_CAS_LOGIN_URL=
FASTTASK_CAS_LOGIN_URL=
FASTPPT_CAS_LOGIN_URL=
FASTLAB_CAS_LOGIN_URL=

# Independent service identities. No fallback after a failed OAuth grant.
FASTTASK_SERVICE_ISSUER=
FASTTASK_SERVICE_CLIENT_ID=
FASTTASK_SERVICE_CLIENT_SECRET=
FASTTASK_SERVICE_ALLOW_LOOPBACK_HTTP=false
FASTWRITE_FASTCAS_SERVICE_ISSUER=
FASTWRITE_FASTCAS_SERVICE_CLIENT_ID=
FASTWRITE_FASTCAS_SERVICE_CLIENT_SECRET=
FASTWRITE_FASTCAS_SERVICE_ALLOW_LOOPBACK_HTTP=false
FASTWRITE_SERVICE_SCOPE=integrations:fastresearch

# Workspace summaries: FastCAS service client fastresearch, scope workspace:read.
# Omit all three to reuse the configured Write/Task OAuth service identity.
FASTRESEARCH_WORKSPACE_SERVICE_ISSUER=
FASTRESEARCH_WORKSPACE_SERVICE_CLIENT_ID=
FASTRESEARCH_WORKSPACE_SERVICE_CLIENT_SECRET=
FASTRESEARCH_WORKSPACE_SERVICE_ALLOW_LOOPBACK_HTTP=false
FASTNEWS_REGISTER_URL=
FASTREAD_REGISTER_URL=
FASTWRITE_REGISTER_URL=
